# Django Settings
SECRET_KEY=django-replace-with-your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for docker-compose)
# Si usas docker-compose, estas variables son opcionales
# La base de datos se configura en docker-compose.yaml
DATABASE_URL=

# Para desarrollo local sin Docker
# Si quieres usar PostgreSQL localmente, configura la URL aquí
# DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db

# Puerto (para Docker)
PORT=8000